/random/setSavingFlag 1
#/analysis/setFileName analysis_Par04.root
#/param/ActivateModel DefineMeshModel
#/param/listModels
#/param/listIsApplicable

/gps/particle gamma
/gps/ene/type Pow
/gps/ene/min 10.0 GeV
/gps/ene/max 10.0 GeV
/gps/direction 0 0 -1
/gps/pos/centre 0 0 0
#/gps/ene/alpha -1
#/gps/ang/type iso
#/gps/ang/mintheta 0.87 rad
#/gps/ang/maxtheta 2.27 rad
#/gps/ang/minphi 0
#/gps/ang/maxphi 6.283 rad

/run/beamOn 100
